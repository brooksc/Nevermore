#!/bin/bash
# Build the app from the current source and launch it. Debug + host-arch by
# default, which is the fast edit/run loop; pass `release` for a release build.
# Any further arguments go to the app itself.
#
#   ./run                 # debug build, launch
#   ./run release         # release build, launch
set -euo pipefail

CONFIG=debug
if [ "${1:-}" = "debug" ] || [ "${1:-}" = "release" ]; then
  CONFIG=$1
  shift
fi

cd "$(dirname "$0")/Packages/NevermoreKit"

echo "Building ($CONFIG, $(uname -m))…" >&2
echo "A first build, or the first after a dependency change, takes a few minutes." >&2
START=$SECONDS

# make-app.sh prints progress and the finished bundle path to stdout, so the
# path is the last line. `tee /dev/stderr` keeps that progress visible while it
# happens — capturing stdout alone means several silent minutes with no sign
# the build is alive, which reads as a hung script.
APP=$(NEVERMORE_ARCHS=${NEVERMORE_ARCHS:-native} ./make-app.sh "$CONFIG" | tee /dev/stderr | tail -1)

echo "Built in $((SECONDS - START))s: $APP" >&2

# Quit any copy already running so the launch below is the build we just made,
# not the old one the Dock still holds open. Several bundles share this bundle
# id — the DMG build, the sandboxed build, a Sparkle-installed copy in
# ~/Applications — and `open` on a running bundle id just activates whatever is
# already up.
osascript -e 'quit app "Nevermore"' 2>/dev/null || true
sleep 1

open "$APP" ${1+--args "$@"}

# Confirm the thing that came up is the thing just built, since a stale
# instance that refused to quit would otherwise look like a successful launch.
sleep 3
if pgrep -f "$APP/Contents/MacOS/Nevermore" >/dev/null; then
  echo "Running: $(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$APP/Contents/Info.plist") ($(/usr/libexec/PlistBuddy -c 'Print CFBundleVersion' "$APP/Contents/Info.plist"))" >&2
else
  echo "WARNING: that bundle is not running. Another copy may have taken the" >&2
  echo "         launch — check with: pgrep -lf Nevermore.app/Contents/MacOS" >&2
fi
