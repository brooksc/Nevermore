# Swift / SwiftPM
.build/
.swiftpm/
# Coverage output dropped in the working dir by instrumented test runs.
*.profraw
*.profdata
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
# Package.resolved IS committed: this becomes an app, so pinning the exact
# dependency graph is what makes a clean checkout build identically.

# Tuist generates the Xcode project for the Mac App Store target from
# Project.swift; the manifest is the source of truth, the project is a build
# artifact. Run `tuist generate` after a checkout. See MAS-RELEASE.md.
Nevermore.xcodeproj/
Nevermore.xcworkspace/
.tuist-bin/
Derived/
# xcarchive and the signed .pkg for App Store delivery.
build/

# Python bytecode (belt-and-braces; the Python spike has been removed)
__pycache__/
*.pyc

# Local run artifacts — the probe writes a real Gmail header cache here.
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Secrets — never commit credentials of any kind.
.env
.envrc
*.app-password
credentials.json
token*.json

# macOS
.DS_Store

# Sparkle signing: the public key is committed, the private key never is.
sparkle-private-key.txt
